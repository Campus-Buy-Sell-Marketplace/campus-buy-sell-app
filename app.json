{
  "expo": {
    "name": "UniTrade",
    "slug": "unitrade",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#111827"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.unitrade.campusapp"
    },
    "android": {
      "package": "com.unitrade.campusapp",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111827"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#111827",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "UniTrade needs access to your photos to upload product images.",
          "cameraPermission": "UniTrade needs camera access to take product photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "UniTrade needs camera access to take product photos."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3a69dfc9-e858-4b17-88bc-00bb8ace9b4e"
      }
    }
  }
}
